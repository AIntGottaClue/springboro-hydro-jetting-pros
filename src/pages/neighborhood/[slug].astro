---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Callout from '../../components/Callout.astro';
import { neighborhoods } from '../../data/neighborhoods';
import { services } from '../../data/pages';
import { business } from '../../lib/site';
import { u } from '../../lib/utils';
import { faqSchema } from '../../lib/seo';
export function getStaticPaths() { return neighborhoods.map((n) => ({ params: { slug: n.slug }, props: { n } })); }
const { n } = Astro.props;
const icons: Record<string, string> = {
  drop: '<path d="M12 2.5c3.4 4.2 6 7.4 6 10.9A6 6 0 0 1 6 13.4c0-3.5 2.6-6.7 6-10.9Z"/>',
  leaf: '<path d="M5 19c0-9 5-14 15-14 0 10-5 15-14 15l-1 0zM5 19l7-7" fill="none" stroke="currentColor" stroke-width="2"/>',
  repeat: '<path d="M17 2l4 4-4 4M3 11V9a3 3 0 0 1 3-3h15M7 22l-4-4 4-4M21 13v2a3 3 0 0 1-3 3H3" fill="none" stroke="currentColor" stroke-width="2"/>',
  layers: '<path d="M12 3l9 5-9 5-9-5 9-5zM3 13l9 5 9-5" fill="none" stroke="currentColor" stroke-width="2"/>',
  shield: '<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3z" fill="none" stroke="currentColor" stroke-width="2"/>',
};
const others = neighborhoods.filter((x) => x.slug !== n.slug);
const crumbs = [{ name: 'Neighborhoods', path: '/neighborhood/' }, { name: n.name, path: `/neighborhood/${n.slug}/` }];
const heroCrumbs = [{ href: '/neighborhood/', label: 'Neighborhoods' }, { href: `/neighborhood/${n.slug}/`, label: n.name }];
---
<Base title={n.title} description={n.description} path={`/neighborhood/${n.slug}/`} crumbs={crumbs} service={true} extraSchema={[faqSchema(n.faqs)]}>
  <Hero headline={n.h1} intro={n.heroPs[0]} paras={n.heroPs.slice(1)} location={n.name} crumbs={heroCrumbs} />
  <section class="sec sec-white"><div class="sec-in prose">
    <h2>{n.bodyH2}</h2>
    {n.bodyPs.map((p) => <p>{p}</p>)}
    <h3>What Local Property Owners Often Consider</h3>
    <ul>{n.considerations.map((c) => <li>{c}</li>)}</ul>
  </div></section>
  <section class="sec sec-cream"><div class="sec-in">
    <h2 class="sec-title">{n.svcH2}</h2>
    <p class="sec-lead">{n.svcLead}</p>
    <div class="svc-grid">{services.map((s) => <a class="svc" href={u(`/services/${s.slug}/`)}><span class="svc-ico"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={icons[s.icon]} /></span><span class="eb">Service</span><h3>{s.name}</h3><p>{n.svcNotes[s.slug] ?? s.blurb}</p><span class="arrow">Learn more &rarr;</span></a>)}</div>
  </div></section>
  <section class="sec sec-low"><div class="sec-in prose">
    <h2>{n.appsH2}</h2>
    {n.apps.map((a) => (<><h3>{a.h}</h3>{a.ps.map((p) => <p>{p}</p>)}</>))}
  </div></section>
  <section class="sec sec-white"><div class="sec-in prose">
    <h2>{n.implH2}</h2>
    {n.implPs.map((p) => <p>{p}</p>)}
    {n.impl.map((s) => (<><h3>{s.h}</h3>{s.ps.map((p) => <p>{p}</p>)}{s.bullets && <ul>{s.bullets.map((b) => <li>{b}</li>)}</ul>}</>))}
  </div></section>
  <section class="sec sec-low"><div class="sec-in">
    <h2 class="sec-title">{n.planH2}</h2>
    <div class="prose plan-intro">{n.planPs.map((p) => <p>{p}</p>)}</div>
    <div class="steps">{n.steps.map((s, i) => <div class="step"><span class="num">{String(i + 1).padStart(2, '0')}</span><h3>{s.t}</h3><p>{s.d}</p></div>)}</div>
  </div></section>
  <section class="sec sec-white"><div class="sec-in prose">
    <h2>{n.mapH2}</h2>
    <p>{n.mapIntro}</p>
    <div class="map-wrap"><iframe src={`https://www.google.com/maps?q=${encodeURIComponent(n.mapQuery)}&output=embed`} width="100%" height="450" style="border:0;" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title={n.mapTitle}></iframe></div>
  </div></section>
  <section class="sec sec-cream"><div class="sec-in">
    <h2 class="sec-title">{n.nearbyH2}</h2>
    <p class="sec-lead">{n.nearbyP}</p>
    <div class="pill-grid">{others.map((o) => <a class="pill" href={u(`/neighborhood/${o.slug}/`)}>{o.name}</a>)}</div>
    <p class="nearby-note">The Neighborhoods menu lists every Springboro area page on this site.</p>
  </div></section>
  <section class="sec sec-low"><div class="sec-in">
    <h2 class="sec-title">{n.faqH2}</h2>
    <div class="faq">{n.faqs.map((f) => <article><h3>{f.q}</h3><p>{f.a}</p></article>)}</div>
  </div></section>
  <section class="sec sec-white"><div class="sec-in prose">
    <h2>{n.ctaH2}</h2>
    {n.ctaPs.map((p) => <p>{p}</p>)}
    <p class="cta-row"><a class="button-primary" href="#request-service">Request service</a><span class="cta-phone">or call <a href={business.phoneHref}>{business.phoneDisplay}</a></span></p>
  </div></section>
  <Callout />
</Base>
